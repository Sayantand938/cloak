{
  "name": "cloak",
  "version": "1.3.0",
  "description": "AES-256-GCM encrypted .env file manager — seal secrets, inject in RAM, never touch disk",
  "keywords": [
    "env",
    "dotenv",
    "encryption",
    "aes-256-gcm",
    "secrets",
    "environment-variables",
    "cli",
    "security"
  ],
  "homepage": "https://github.com/SayantanD938/cloak#readme",
  "bugs": {
    "url": "https://github.com/SayantanD938/cloak/issues"
  },
  "license": "MIT",
  "author": "Sayantan Das <sayantan.das938@gmail.com> (https://github.com/SayantanD938)",
  "funding": "https://github.com/sponsors/SayantanD938",
  "type": "module",
  "main": "src/cli.js",
  "exports": {
    ".": "./src/cli.js",
    "./crypto": "./src/crypto.js"
  },
  "bin": {
    "cloak": "./bin/cloak.js"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/*.test.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "start": "node bin/cloak.js",
    "test": "node --test test/**/*.test.js",
    "prepublishOnly": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "dotenv": "^18.0.4",
    "js-yaml": "^5.4.2",
    "picocolors": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SayantanD938/cloak.git"
  }
}
